<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ro.victorrentea.conversations-backup</string>

    <!-- Merges every local AI conversation onto the "Vic" drive, once a day.
         StartOnMount wakes it the moment any volume mounts — plugging the
         drive in; the hourly interval covers a drive that just stays plugged.
         Without the drive, or within 20 h of the last good run, the script
         exits in milliseconds, so the frequent triggers cost nothing. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/victorrentea/workspace/victor-macos-addons/conversations-backup.sh</string>
    </array>

    <key>StartOnMount</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>

    <!-- The script keeps its own log at ~/.conversations-backup/backup.log. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/Users/victorrentea/.conversations-backup/launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/victorrentea</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
